# Copy to backend/.env for running the API outside Docker (make dev-api).
ENVIRONMENT=local
DATABASE_URL=mysql+aiomysql://portal:portal@localhost:3306/portal
REDIS_URL=redis://localhost:6379/0
# Required outside local/test. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=local-dev-secret-change-me-0123456789abcdef
CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO
